# --- Telegram Bot ---
# Obtained from @BotFather when creating your bot.
# Never commit the real token. Put it in a local .env file instead.
BOT_TOKEN=your_bot_token_here

# Optional: your bot's username (without the leading @), e.g. MyReminderBot
BOT_USERNAME=

# --- Networking ---
# Telegram is blocked on the host's network (e.g. Russia), so all Bot API calls
# are routed through a relay that proxies api.telegram.org. The app builds
#   <TELEGRAM_API_BASE_URL><BOT_TOKEN>/<method>
# so it MUST end with "/bot". Example:
TELEGRAM_API_BASE_URL=https://tgproxy-plum.vercel.app/bot
# Files (attachments) are fetched from api.telegram.org/file/bot<token>/...
# Leave empty to reuse the API base; set only if the relay also proxies files.
TELEGRAM_FILE_BASE_URL=

# --- Persistence ---
# Path to the SQLite database file (relative to the project root).
DB_PATH=data/app.db

# --- Scheduler ---
# IANA timezone used for the daily reminder job.
# See https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
SCHEDULER_TIMEZONE=Europe/Moscow

# --- Logging ---
# Minimum level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
# Directory and file for the rotating log. Relative paths resolve to the project root.
LOG_DIR=logs
LOG_FILE=bot.log
# Each rotated file size in bytes and how many old files to keep.
LOG_MAX_BYTES=2000000
LOG_BACKUP_COUNT=7
